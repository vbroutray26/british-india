---
import Base from '../../../layouts/Base.astro';
import PlaceSearch from '../../../components/PlaceSearch.astro';
import { LOCALES, t, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const config = {
  places: `/${lang}/search/places.json`,
  label: t('search.passages', lang),
  labels: { page: t('quote.page', lang), noResults: t('search.noPassages', lang), searching: t('search.searching', lang) },
  countTemplate: t('search.passagesFound', lang),
  placesHeading: t('search.placesHeading', lang),
  unavailable: t('search.unavailable', lang),
};
---
<Base lang={lang} title={t('search.title', lang)}>
  <section class="page-head">
    <h1>{t('search.title', lang)}</h1>
    <p class="lede">{t('search.lede', lang)}</p>
    <PlaceSearch lang={lang} size="lg" />
  </section>
  <section class="found" aria-labelledby="places-h" hidden data-places-found>
    <h2 id="places-h">{config.placesHeading}</h2>
    <ul class="place-hits"></ul>
  </section>
  <section class="found" aria-labelledby="passages-h">
    <h2 id="passages-h">{config.label}</h2>
    <div data-passage-results={JSON.stringify(config)}>
      <noscript><p>{t('search.noscript', lang)}</p></noscript>
    </div>
  </section>
</Base>

<script>
  // Passage search with Pagefind (FR-SRCH-04, AC-SRCH-04). Each result links to the printed page within the
  // text (page headings are the index's sub-results) and shows the source and the highlighted match.
  import { mount, unmount } from 'svelte';
  import SearchResults from '@bi/ui/components/SearchResults.svelte';
  import { matchPlaces, type PlaceIndexItem } from '../../../search/places';

  const el = document.querySelector<HTMLElement>('[data-passage-results]')!;
  const c = JSON.parse(el.dataset.passageResults!);
  const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  const box = document.querySelector<HTMLInputElement>('[data-place-search] input');
  if (box) box.value = q;
  const show = (state: 'idle' | 'loading' | 'done', results: unknown[] = []) => {
    if (current) unmount(current);
    el.replaceChildren();
    current = mount(SearchResults, { target: el, props: {
      label: c.label, query: q, state, results,
      labels: { ...c.labels, count: (n: number) => c.countTemplate.replace('{n}', String(n)) },
    } });
  };
  let current: ReturnType<typeof mount> | undefined;

  async function run() {
    if (!q) { show('idle'); return; }
    show('loading');
    const places: PlaceIndexItem[] = await fetch(c.places).then((r) => r.json());
    const hits = matchPlaces(q, places);
    if (hits.length) {
      const sec = document.querySelector<HTMLElement>('[data-places-found]')!;
      const ul = sec.querySelector('ul')!;
      for (const h of hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = h.href; a.textContent = h.name;
        const meta = document.createElement('span');
        meta.className = 'muted'; meta.textContent = ` ${h.type}${h.matched ? ` · ${h.matched}` : ''}`;
        li.append(a, meta); ul.append(li);
      }
      sec.hidden = false;
    }
    try {
      const pagefind = await import(/* @vite-ignore */ `${location.origin}/pagefind/pagefind.js`);
      await pagefind.options({ excerptLength: 32 });
      const res = await pagefind.search(q);
      const data = await Promise.all(res.results.slice(0, 25).map((r: { data: () => Promise<any> }) => r.data()));
      show('done', data.map((d) => {
        const sub = d.sub_results?.find((s: { url: string }) => /#page-/.test(s.url));
        return { title: d.meta.title, href: sub?.url ?? d.url, excerpt: sub?.excerpt ?? d.excerpt,
          page: sub ? sub.url.split('#page-')[1] : undefined, source: d.meta.source };
      }));
    } catch {
      el.replaceChildren(Object.assign(document.createElement('p'), { textContent: c.unavailable }));
    }
  }
  run();
</script>

<style>
  .page-head { padding-block: var(--space-8) var(--space-6); max-width: var(--layout-reading); display: grid; gap: var(--space-3); }
  .page-head h1 { font-size: var(--step-5); margin: 0; }
  .lede { font-size: var(--step-1); color: var(--color-text-muted); margin: 0; }
  .found { max-width: var(--layout-reading); margin-bottom: var(--space-12); }
  .found h2 { font-size: var(--step-2); }
  .place-hits { padding-left: var(--space-4); }
  .place-hits li { min-height: 32px; }
  :global(.place-hits .muted) { color: var(--color-text-muted); font-size: var(--step--1); }
</style>
