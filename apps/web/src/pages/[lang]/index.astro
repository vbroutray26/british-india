---
import Base from '../../layouts/Base.astro';
import { LOCALES, t, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
---
<Base lang={lang}>
  <section class="hero">
    <h1>{t('site.title', lang)}</h1>
    <p class="subtitle">{t('site.subtitle', lang)}</p>
    <p class="lede">{t('home.lede', lang)}</p>
    <p>{t('home.status', lang)}</p>
    <p class="notice">{t('home.notice', lang)}</p>
  </section>
</Base>
