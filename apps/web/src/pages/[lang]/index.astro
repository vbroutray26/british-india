---
import Base from '../../layouts/Base.astro';
import PlaceSearch from '../../components/PlaceSearch.astro';
import { LOCALES, t, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
---
<Base lang={lang}>
  <section class="hero">
    <h1 class="hero-title">
      <span class="logo-art" aria-hidden="true"><span class="logo-accent"></span><span class="logo-ink"></span></span>
      <span class={lang === 'en' ? 'visually-hidden' : 'hero-name'}>{t('site.title', lang)}</span>
    </h1>
    <p class="subtitle">{t('site.subtitle', lang)}</p>
    <p class="lede">{t('home.lede', lang)}</p>
    <div class="home-search"><PlaceSearch lang={lang} size="lg" /></div>
    <p class="browse"><a href={`/${lang}/places/`}>{t('home.browse', lang)} →</a></p>
    <p>{t('home.status', lang)}</p>
    <p class="notice">{t('home.notice', lang)}</p>
  </section>
</Base>
