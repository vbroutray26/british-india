---
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL, GITHUB_REPO } from '../../config';
import { INFO_PAGES, LOCALES, t, type InfoPage, type Locale } from '../../i18n';
export function getStaticPaths() {
  return LOCALES.flatMap((lang) => INFO_PAGES.map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as Locale;
const page = Astro.params.page as InfoPage;
const title = t(`footer.${page}`, lang);
---
<Base lang={lang} title={title}>
  <section class="hero">
    <h1>{title}</h1>
    <p>{t('page.pending', lang)}</p>
    {['contact', 'corrections', 'takedown'].includes(page) && (
      <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> · <a href={`${GITHUB_REPO}/issues`}>GitHub</a></p>
    )}
    <p><a href={`/${lang}/`}>{t('page.home', lang)}</a></p>
  </section>
</Base>
