      "accent": "#3CC3CC", "accent-2": "#FF8A65", "highlight": "#FFD166", "rule": "#253041"
    }
  },
  "semantic": {
    "then": {
      "bg": "then.paper", "surface": "then.paper-2", "text": "then.ink", "text-muted": "then.ink-muted",
      "link": "then.red", "focus": "then.blue", "rule": "then.rule", "ai": "then.ochre"
    },
    "now": {
      "bg": "now.bg", "surface": "now.surface", "text": "now.ink", "text-muted": "now.ink-muted",
      "link": "now.accent", "focus": "now.accent-2", "rule": "now.rule", "ai": "now.accent-2"
    }
  },
  "space": { "0-5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "32": "128px" },
  "radius": { "sm": "2px", "md": "6px", "lg": "12px", "pill": "999px" },
  "font": {
    "display": "Georgia, 'Times New Roman', serif",
    "serif": "Georgia, 'Noto Serif Devanagari', 'Noto Serif Oriya', serif",
    "sans": "system-ui, -apple-system, 'Segoe UI', 'Noto Sans Devanagari', 'Noto Sans Oriya', sans-serif",
    "mono": "ui-monospace, 'SFMono-Regular', Menlo, monospace"
  },
  "step": {
    "-1": "clamp(0.8rem, 0.78rem + 0.1vw, 0.9rem)",
    "0": "clamp(1rem, 0.95rem + 0.25vw, 1.125rem)",
    "1": "clamp(1.25rem, 1.17rem + 0.4vw, 1.41rem)",
