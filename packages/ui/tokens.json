    "3": "clamp(1.95rem, 1.76rem + 0.95vw, 2.2rem)",
    "4": "clamp(2.44rem, 2.14rem + 1.5vw, 2.75rem)",
    "5": "clamp(3.05rem, 2.6rem + 2.25vw, 3.43rem)",
    "6": "clamp(3.81rem, 3.15rem + 3.3vw, 4.29rem)",
    "7": "clamp(4.77rem, 3.8rem + 4.8vw, 5.36rem)"
  },
  "leading": { "latin": "1.55", "deva": "1.7", "odia": "1.75" },
  "duration": { "xs": "120ms", "sm": "200ms", "md": "360ms", "lg": "600ms", "xl": "900ms", "hero": "1400ms" },
  "ease": { "out": "cubic-bezier(.2,.8,.2,1)", "in-out": "cubic-bezier(.65,0,.35,1)" },
