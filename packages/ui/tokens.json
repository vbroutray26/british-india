  "font": {
    "$comment": "Per-language stacks (D-17). Each lists only its own script so shared characters (danda, ZWJ) never pull in another script's font. Elements with lang=\"or\"/\"hi\" inside other pages get their stack via :lang().",
    "en": {
      "display": "'Gloock', Georgia, serif",
      "serif": "'Newsreader Variable', Georgia, serif",
      "sans": "'Urbanist Variable', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "or": {
      "display": "'Gloock', 'Noto Serif Oriya Variable', serif",
      "serif": "'Newsreader Variable', 'Noto Serif Oriya Variable', serif",
      "sans": "'Urbanist Variable', 'Anek Odia', system-ui, sans-serif"
    },
    "hi": {
      "display": "'Gloock', 'Rozha One', serif",
      "serif": "'Newsreader Variable', 'Rozha One', serif",
      "sans": "'Urbanist Variable', 'Anek Devanagari', system-ui, sans-serif"
    },
    "mono": "ui-monospace, 'SFMono-Regular', Menlo, monospace"
  },
  "step": {
    "-1": "clamp(0.8rem, 0.78rem + 0.1vw, 0.9rem)",
