      "red": "#A63A24", "blue": "#2B4A7A", "ochre": "#B9822B", "green": "#5C6B4A", "rule": "#B8A988"
    },
    "then-dark": {
      "paper": "#17130E", "paper-2": "#221C15", "ink": "#EFE5CF", "ink-muted": "#BFB194",
      "red": "#E07A5F", "blue": "#8FA9D6", "ochre": "#D9A34E", "green": "#9DAE86", "rule": "#4A3F31"
    },
    "now": {
      "bg": "#FAFAF7", "surface": "#FFFFFF", "ink": "#111827", "ink-muted": "#4B5563",
      "accent": "#0E7C86", "accent-2": "#E4572E", "highlight": "#FFD166", "rule": "#E5E7EB"
